<Window x:Class="PoeAlarm.App.RulesUi.StructuredRuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PoeAlarm.App.RulesUi"
        Width="850"
        Height="820"
        MinWidth="720"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource MainWindowShell}">
  <Window.Resources>
    <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:InverseBooleanConverter x:Key="InverseBool" />
    <Style x:Key="EditorLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="1,0,0,5" />
    </Style>
    <Style x:Key="CompactEditorTextBox" TargetType="TextBox" BasedOn="{StaticResource GlassTextBox}">
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="CompactEditorComboBox" TargetType="ComboBox" BasedOn="{StaticResource GlassComboBox}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="22,18,22,16"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock FontFamily="{StaticResource DisplayFont}"
                   FontSize="23"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Text="{Binding Text.Heading}" />
        <TextBlock Margin="0,5,0,0"
                   Style="{StaticResource SecondaryText}"
                   Text="{Binding Text.Introduction}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1"
                  Padding="22,18,22,12"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Style="{StaticResource EditorLabel}" Text="{Binding Text.RuleSetNameLabel}" />
        <TextBox Style="{StaticResource GlassTextBox}"
                 Text="{Binding RuleSetName, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{Binding Text.RuleSetNamePlaceholder}" />

        <Border Margin="0,12,0,15"
                Padding="12,10"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="{StaticResource FocusBrush}"
                BorderThickness="1"
                CornerRadius="10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,10,0"
                       VerticalAlignment="Top"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="18"
                       FontWeight="Bold"
                       Text="i" />
            <StackPanel Grid.Column="1">
              <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                         FontWeight="SemiBold"
                         Text="{Binding Text.DisplayValueWarningTitle}" />
              <TextBlock Margin="0,3,0,0"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Text="{Binding Text.DisplayValueWarning}" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource SectionTitle}"
                       Text="{Binding Text.AcceptableResultsHeading}" />
            <Border Margin="10,0,0,0"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceTintBrush}"
                    CornerRadius="8">
              <TextBlock Foreground="{StaticResource AccentBrush}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Text="{Binding Text.OrExplanation}" />
            </Border>
          </StackPanel>
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     FontSize="12"
                     Text="{Binding CounterText}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,10"
                      Padding="0"
                      Background="{StaticResource SurfaceBrush}"
                      BorderBrush="{StaticResource CardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="13">
                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                          Style="{StaticResource GlassExpander}">
                  <Expander.Header>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding HeaderTitle}" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Text="{Binding HeaderSummary}" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Margin="8,0,0,0"
                              Padding="10,4"
                              VerticalAlignment="Center"
                              Background="{StaticResource DangerSoftBrush}"
                              BorderBrush="{StaticResource DangerSoftBrush}"
                              Foreground="{StaticResource DangerBrush}"
                              Content="{Binding DataContext.Text.DeleteResult, RelativeSource={RelativeSource AncestorType=Window}}"
                              Click="OnDeleteGroup"
                              Style="{StaticResource BaseButton}" />
                    </Grid>
                  </Expander.Header>

                  <StackPanel Margin="14,0,14,14">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="135" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource EditorLabel}"
                                   Text="{Binding DataContext.Text.ResultNameLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBox Style="{StaticResource CompactEditorTextBox}"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource EditorLabel}"
                                   Text="{Binding DataContext.Text.GroupModeLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ComboBox ItemsSource="{Binding ModeOptions}"
                                  DisplayMemberPath="Display"
                                  SelectedValue="{Binding Mode, Mode=TwoWay}"
                                  SelectedValuePath="Value"
                                  Style="{StaticResource CompactEditorComboBox}" />
                      </StackPanel>
                      <StackPanel Grid.Column="4"
                                  Visibility="{Binding IsAtLeast, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource EditorLabel}"
                                   Text="{Binding DataContext.Text.RequiredCountLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ComboBox ItemsSource="{Binding RequiredCountOptions}"
                                  SelectedItem="{Binding RequiredCount, Mode=TwoWay}"
                                  Style="{StaticResource CompactEditorComboBox}" />
                      </StackPanel>
                    </Grid>

                    <TextBlock Margin="1,14,0,7"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               Text="{Binding DataContext.Text.ConditionsHeading, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <ItemsControl ItemsSource="{Binding Conditions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,8"
                                  Padding="12"
                                  Background="{StaticResource SurfaceMutedBrush}"
                                  BorderBrush="{StaticResource CardBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="10">
                            <StackPanel>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                  <TextBlock Style="{StaticResource EditorLabel}"
                                             Text="{Binding DataContext.Text.ConditionNameLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                                  <TextBox Style="{StaticResource CompactEditorTextBox}"
                                           Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="10,17,0,0"
                                        Padding="9,4"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource DangerSoftBrush}"
                                        BorderBrush="{StaticResource DangerSoftBrush}"
                                        Foreground="{StaticResource DangerBrush}"
                                        Content="{Binding DataContext.Text.DeleteCondition, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Click="OnDeleteCondition"
                                        Style="{StaticResource BaseButton}" />
                              </Grid>

                              <TextBlock Margin="1,9,0,5"
                                         Style="{StaticResource EditorLabel}"
                                         Text="{Binding DataContext.Text.TemplateLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                              <TextBox MinHeight="56"
                                       AcceptsReturn="True"
                                       TextWrapping="Wrap"
                                       VerticalScrollBarVisibility="Auto"
                                       Style="{StaticResource CompactEditorTextBox}"
                                       Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}" />
                              <TextBlock Margin="2,5,2,0"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         FontSize="11"
                                         TextWrapping="Wrap"
                                         Text="{Binding DataContext.Text.TemplateHelp, RelativeSource={RelativeSource AncestorType=Window}}" />
                              <TextBlock Margin="2,5,2,0"
                                         Foreground="{StaticResource AccentBrush}"
                                         FontSize="11"
                                         TextWrapping="Wrap"
                                         Text="{Binding TemplateStatus}" />

                              <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding NumericSlots}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="9"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                      <StackPanel>
                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Label}" />
                                        <Grid Margin="0,6,0,0">
                                          <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                          </Grid.ColumnDefinitions>
                                          <ComboBox Grid.Column="0"
                                                    ItemsSource="{Binding ModeOptions}"
                                                    DisplayMemberPath="Display"
                                                    SelectedValue="{Binding Mode, Mode=TwoWay}"
                                                    SelectedValuePath="Value"
                                                    Style="{StaticResource CompactEditorComboBox}" />
                                          <Grid Grid.Column="2">
                                            <Grid Visibility="{Binding ShowRangeInputs, Converter={StaticResource BoolToVisibility}}">
                                              <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                              </Grid.ColumnDefinitions>
                                              <TextBox Grid.Column="0"
                                                       Style="{StaticResource CompactEditorTextBox}"
                                                       Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}"
                                                       ToolTip="{Binding DataContext.Text.MinimumLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                                              <TextBox Grid.Column="2"
                                                       Style="{StaticResource CompactEditorTextBox}"
                                                       Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}"
                                                       ToolTip="{Binding DataContext.Text.MaximumLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Grid>
                                            <TextBox Visibility="{Binding ShowMinimumInput, Converter={StaticResource BoolToVisibility}}"
                                                     Style="{StaticResource CompactEditorTextBox}"
                                                     Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding DataContext.Text.MinimumLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBox Visibility="{Binding ShowMaximumInput, Converter={StaticResource BoolToVisibility}}"
                                                     Style="{StaticResource CompactEditorTextBox}"
                                                     Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding DataContext.Text.MaximumLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBox Visibility="{Binding ShowExpectedInput, Converter={StaticResource BoolToVisibility}}"
                                                     Style="{StaticResource CompactEditorTextBox}"
                                                     Text="{Binding Expected, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding DataContext.Text.ExactValueLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                                          </Grid>
                                        </Grid>
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button HorizontalAlignment="Left"
                            IsEnabled="{Binding DataContext.CanAddCondition, RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="{Binding DataContext.Text.AddCondition, RelativeSource={RelativeSource AncestorType=Window}}"
                            Click="OnAddCondition"
                            Style="{StaticResource GhostButton}" />
                  </StackPanel>
                </Expander>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Margin="0,2,0,0"
                HorizontalAlignment="Left"
                Content="{Binding Text.AddResult}"
                IsEnabled="{Binding CanAddGroup}"
                Click="OnAddGroup"
                Style="{StaticResource GhostButton}" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Padding="18,12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button MinWidth="100"
                Margin="0,0,8,0"
                Content="{Binding Text.Cancel}"
                IsCancel="True"
                Click="OnCancel"
                Style="{StaticResource SecondaryButton}" />
        <Button MinWidth="150"
                Content="{Binding Text.Save}"
                IsDefault="True"
                Click="OnSave"
                Style="{StaticResource PrimaryButton}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
