<Window x:Class="PoeAlarm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POE Alarm"
        Width="570"
        Height="680"
        MinWidth="520"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainWindowShell}"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
  <ScrollViewer x:Name="MainScrollViewer"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="18,16,18,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="2,0,2,13">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="AppTitleText"
                   Grid.Row="0"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontFamily="{StaticResource DisplayFont}"
                   FontSize="25"
                   FontWeight="SemiBold"
                   Text="POE Alarm" />

        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Margin="14,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <StackPanel Margin="0,0,8,0">
            <TextBlock x:Name="GameProfileLabelText"
                       Margin="2,0,0,3"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11"
                       Text="游戏版本" />
            <ComboBox x:Name="GameProfileComboBox"
                      Width="126"
                      SelectedIndex="0"
                      SelectedValuePath="Tag"
                      SelectionChanged="OnGameProfileChanged"
                      Style="{StaticResource GlassComboBox}"
                      ToolTip="POE1 与 POE2 会分别保存目标词缀、框选区域和识别语言。">
              <ComboBoxItem x:Name="Poe1GameProfileOption" Tag="Poe1" Content="Path of Exile 1" />
              <ComboBoxItem x:Name="Poe2GameProfileOption" Tag="Poe2" Content="Path of Exile 2" />
            </ComboBox>
          </StackPanel>
          <Button x:Name="HelpButton"
                  MinWidth="88"
                  VerticalAlignment="Bottom"
                  Content="使用说明"
                  Click="OnShowHelp"
                  Style="{StaticResource GhostButton}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
          <TextBlock x:Name="AppSubtitleText"
                     Margin="1,6,0,0"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     FontSize="13"
                     TextWrapping="Wrap"
                     Text="快速识别完整词缀，在点过头之前替你停手" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Style="{StaticResource GlassCard}">
        <StackPanel>
          <Grid Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="28"
                    Height="28"
                    Margin="0,0,10,0"
                    Background="{StaticResource AccentSoftBrush}"
                    CornerRadius="14">
              <TextBlock x:Name="TargetStepNumberText"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource AccentBrush}"
                         FontSize="13"
                         FontWeight="Bold"
                         Text="1" />
            </Border>
            <TextBlock x:Name="TargetSectionTitleText"
                       Grid.Column="1"
                       Style="{StaticResource SectionTitle}"
                       Text="目标整句" />
            <Button x:Name="PasteButton"
                    Grid.Column="2"
                    MinWidth="132"
                    Content="从剪贴板粘贴"
                    Click="OnPasteTemplate"
                    Style="{StaticResource SecondaryButton}" />
          </Grid>

          <Grid Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="250" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RuleModeLabelText"
                       Grid.Column="0"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="目标模式" />
            <ComboBox x:Name="RuleModeComboBox"
                      Grid.Column="1"
                      SelectedIndex="0"
                      SelectedValuePath="Tag"
                      SelectionChanged="OnRuleModeChanged"
                      Style="{StaticResource GlassComboBox}"
                      ToolTip="只需监控一条词缀时选单词缀；需要多种停手结果或指定数值时选组合规则。">
              <ComboBoxItem x:Name="QuickRuleModeOption" Tag="Quick" Content="单词缀" />
              <ComboBoxItem x:Name="StructuredRuleModeOption" Tag="Structured" Content="多词缀组合" />
            </ComboBox>
          </Grid>

          <StackPanel x:Name="QuickRulePanel">
            <TextBox x:Name="TargetAffixTextBox"
                     Height="76"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="OnTargetAffixChanged"
                     Style="{StaticResource GlassTextBox}"
                     ToolTip="直接粘贴 PoEDB 的完整词缀；数值大小会自动忽略。" />

            <Border Margin="0,8,0,0"
                    Padding="10,7"
                    Background="{StaticResource SurfaceTintBrush}"
                    CornerRadius="9">
              <TextBlock x:Name="CanonicalPreviewText"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         FontFamily="{StaticResource MonoFont}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Text="等待输入完整词缀；所有文字都会参与匹配，数值大小会自动忽略。" />
            </Border>
          </StackPanel>

          <Border x:Name="StructuredRulePanel"
                  Padding="12,10"
                  Background="{StaticResource SurfaceTintBrush}"
                  CornerRadius="9"
                  Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock x:Name="StructuredRuleSummaryText"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="尚未配置多词缀规则" />
                <TextBlock x:Name="StructuredRuleHintText"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="命中任意一种停手结果就会报警。同一条词缀不会重复计数。"
                           ToolTip="命中任意一种停手结果就会报警。同一条词缀不会重复计数。" />
              </StackPanel>
              <Button x:Name="EditStructuredRulesButton"
                      Grid.Column="1"
                      MinWidth="118"
                      VerticalAlignment="Center"
                      Content="编辑规则"
                      Click="OnEditStructuredRules"
                      Style="{StaticResource SecondaryButton}" />
            </Grid>
          </Border>

          <Grid Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="250" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="OcrLanguageLabelText"
                       Grid.Column="0"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="游戏语言" />
            <ComboBox x:Name="OcrLanguageComboBox"
                      Grid.Column="1"
                      SelectedIndex="0"
                      SelectedValuePath="Tag"
                      SelectionChanged="OnOcrLanguageChanged"
                      Style="{StaticResource GlassComboBox}"
                      ToolTip="请选择游戏内词缀使用的语言。这与程序界面语言相互独立。">
              <ComboBoxItem x:Name="EnglishOcrOption" Tag="en" Content="英文（稳定）" />
              <ComboBoxItem x:Name="TraditionalChineseOcrOption" Tag="zh-TW" Content="繁體中文（快速识别）" />
            </ComboBox>
          </Grid>

        </StackPanel>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource GlassCard}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Width="28"
                  Height="28"
                  Margin="0,0,10,0"
                  VerticalAlignment="Top"
                  Background="{StaticResource AccentSoftBrush}"
                  CornerRadius="14">
            <TextBlock x:Name="RegionStepNumberText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="13"
                       FontWeight="Bold"
                       Text="2" />
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="RegionSectionTitleText"
                       Style="{StaticResource SectionTitle}"
                       Text="监控区域" />
            <TextBlock x:Name="RegionText"
                       Margin="0,7,16,0"
                       Style="{StaticResource SecondaryText}"
                       Text="尚未选择。游戏内悬停装备后按 Ctrl + Shift + F11 最方便。" />
          </StackPanel>

          <Button x:Name="SelectRegionButton"
                  Grid.Column="2"
                  MinWidth="154"
                  VerticalAlignment="Center"
                  Content="框选提示区域"
                  Click="OnSelectRegion"
                  Style="{StaticResource SecondaryButton}" />
        </Grid>
      </Border>

      <Border Grid.Row="3" Style="{StaticResource GlassCard}">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Width="28"
                    Height="28"
                    Margin="0,0,10,0"
                    Background="{StaticResource AccentSoftBrush}"
                    CornerRadius="14">
              <TextBlock x:Name="RunStepNumberText"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource AccentBrush}"
                         FontSize="13"
                         FontWeight="Bold"
                         Text="3" />
            </Border>
            <TextBlock x:Name="RunSectionTitleText"
                       Grid.Column="1"
                       Style="{StaticResource SectionTitle}"
                       Text="开始监控" />
          </Grid>

          <Grid Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="250" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MonitoringPolicyLabelText"
                       Grid.Column="0"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="点击保护" />
            <ComboBox x:Name="MonitoringPolicyComboBox"
                      Grid.Column="1"
                      SelectedIndex="0"
                      SelectedValuePath="Tag"
                      SelectionChanged="OnMonitoringPolicyChanged"
                      Style="{StaticResource GlassComboBox}"
                      ToolTip="快速模式适合日常连点；谨慎模式会在每次制作后先拦住下一次点击，确认结果后再放行。">
              <ComboBoxItem x:Name="FastMonitoringPolicyOption" Tag="Fast" Content="快速模式" />
              <ComboBoxItem x:Name="GuardedMonitoringPolicyOption" Tag="Guarded" Content="谨慎模式" />
            </ComboBox>
          </Grid>

          <TextBlock x:Name="MonitoringPolicyHintText"
                     Margin="2,0,2,10"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     FontSize="12"
                     Text="保持低延迟识别，适合日常高频制作。"
                     TextWrapping="Wrap" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.45*" />
              <ColumnDefinition Width="0.8*" />
              <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="StartButton"
                    Grid.Column="0"
                    MinWidth="0"
                    Margin="0,0,7,0"
                    Content="开始监控"
                    Click="OnStartMonitoring"
                    Style="{StaticResource PrimaryButton}" />
            <Button x:Name="StopButton"
                    Grid.Column="1"
                    MinWidth="0"
                    Margin="0,0,7,0"
                    Content="停止"
                    Click="OnStopMonitoring"
                    IsEnabled="False"
                    Style="{StaticResource SecondaryButton}" />
            <Button x:Name="AcknowledgeButton"
                    Grid.Column="2"
                    MinWidth="0"
                    Content="确认并关闭告警"
                    Click="OnAcknowledgeAlert"
                    IsEnabled="False"
                    Style="{StaticResource DangerButton}" />
          </Grid>

          <Expander x:Name="DiagnosticToolsExpander"
                    Margin="0,8,0,0"
                    IsExpanded="False"
                    Style="{StaticResource GlassExpander}">
            <Expander.Header>
              <TextBlock x:Name="DiagnosticToolsHeaderText" Text="诊断工具" />
            </Expander.Header>
            <WrapPanel Margin="10,0,0,1">
              <Button x:Name="AnalyzeScreenshotButton"
                      Margin="0,0,10,0"
                      Content="用截图测试"
                      Click="OnAnalyzeScreenshot"
                      Style="{StaticResource SecondaryButton}" />
              <Button x:Name="TestAlertButton"
                      Content="测试阻挡告警"
                      Click="OnTestAlert"
                      Style="{StaticResource SecondaryButton}" />
            </WrapPanel>
          </Expander>
        </StackPanel>
      </Border>

      <Border Grid.Row="4" Style="{StaticResource GlassCard}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusIndicator"
                     Grid.Column="0"
                     Width="10"
                     Height="10"
                     Margin="2,0,10,0"
                     VerticalAlignment="Center"
                     Fill="{StaticResource TextTertiaryBrush}" />
            <TextBlock x:Name="StatusSectionTitleText"
                       Grid.Column="1"
                       Style="{StaticResource SectionTitle}"
                       Text="状态" />
          </Grid>

          <TextBlock x:Name="StatusText"
                     Margin="22,9,0,0"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     FontSize="15"
                     Text="待机"
                     TextWrapping="Wrap" />

          <Expander x:Name="OcrDetailsExpander"
                    Margin="12,8,0,0"
                    IsExpanded="False"
                    Style="{StaticResource GlassExpander}">
            <Expander.Header>
              <TextBlock x:Name="OcrDetailsHeaderText" Text="识别到的文字" />
            </Expander.Header>
            <StackPanel Margin="10,0,0,1">
              <TextBlock x:Name="LatencyText"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         FontFamily="{StaticResource MonoFont}"
                         FontSize="12"
                         Text="尚无扫描数据" />
              <TextBox x:Name="OcrOutputTextBox"
                       Height="96"
                       Margin="0,10,0,0"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       Style="{StaticResource GlassReadOnlyTextBox}"
                       Text="识别到的词缀文字会显示在这里。" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>

      <Border Grid.Row="5" Style="{StaticResource GlassCard}">
        <Expander x:Name="ExperienceSettingsExpander"
                  IsExpanded="False"
                  Style="{StaticResource GlassExpander}">
          <Expander.Header>
            <TextBlock x:Name="ExperienceSettingsHeaderText"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="体验设置" />
          </Expander.Header>

          <StackPanel Margin="10,2,4,2">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="UiLanguageLabelText"
                         Grid.Column="0"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Text="界面语言" />
              <ComboBox x:Name="UiLanguageComboBox"
                        Grid.Column="1"
                        Width="240"
                        HorizontalAlignment="Left"
                        SelectedIndex="0"
                        SelectedValuePath="Tag"
                        SelectionChanged="OnUiLanguageChanged"
                        Style="{StaticResource GlassComboBox}">
                <ComboBoxItem x:Name="SimplifiedChineseUiOption" Tag="zh-CN" Content="简体中文" />
                <ComboBoxItem x:Name="EnglishUiOption" Tag="en" Content="English" />
              </ComboBox>
            </Grid>

            <Border Height="1"
                    Margin="0,14"
                    Background="{StaticResource CardBorderBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="StartHotKeyLabelText"
                         Grid.Column="0"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Text="启动监控热键" />
              <ComboBox x:Name="StartHotKeyComboBox"
                        Grid.Column="1"
                        Width="240"
                        HorizontalAlignment="Left"
                        SelectedIndex="0"
                        SelectedValuePath="Tag"
                        SelectionChanged="OnStartHotKeyChanged"
                        Style="{StaticResource GlassComboBox}">
                <ComboBoxItem Tag="Ctrl+Shift+F10" Content="Ctrl + Shift + F10" />
                <ComboBoxItem Tag="Ctrl+Alt+F10" Content="Ctrl + Alt + F10" />
                <ComboBoxItem Tag="Alt+F10" Content="Alt + F10" />
              </ComboBox>
            </Grid>

            <Border Height="1"
                    Margin="0,14"
                    Background="{StaticResource CardBorderBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="MonitoringHudLabelText"
                         Grid.Column="0"
                         VerticalAlignment="Top"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Text="监控浮窗" />
              <StackPanel Grid.Column="1" Margin="0,0,16,0">
                <CheckBox x:Name="KeepHudVisibleCheckBox"
                          IsChecked="True"
                          Content="监控时显示状态浮窗"
                          Click="OnHudPreferenceChanged"
                          Style="{StaticResource GlassCheckBox}" />
                <TextBlock x:Name="MonitoringHudDescriptionText"
                           Margin="29,6,0,0"
                           Style="{StaticResource SecondaryText}"
                           Text="浮窗会自动贴近监控区域并避开词缀文字。" />
              </StackPanel>
              <Button x:Name="PositionHudButton"
                      Grid.Column="2"
                      MinWidth="124"
                      Content="调整位置"
                      Click="OnPositionHud"
                      Style="{StaticResource SecondaryButton}" />
            </Grid>

            <Border Height="1"
                    Margin="0,14"
                    Background="{StaticResource CardBorderBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="AlertSoundLabelText"
                         Grid.Column="0"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Text="命中提示音" />
              <TextBlock x:Name="CustomSoundText"
                         Grid.Column="1"
                         Margin="0,0,16,0"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Text="内置提示音"
                         TextTrimming="CharacterEllipsis" />
              <Button x:Name="ChooseSoundButton"
                      Grid.Column="2"
                      MinWidth="112"
                      Margin="0,0,9,0"
                      Content="选择 WAV"
                      Click="OnChooseCustomSound"
                      Style="{StaticResource SecondaryButton}" />
              <Button x:Name="ResetSoundButton"
                      Grid.Column="3"
                      MinWidth="86"
                      Content="恢复默认"
                      Click="OnResetAlertSound"
                      Style="{StaticResource GhostButton}" />
            </Grid>

            <Border Height="1"
                    Margin="0,14"
                    Background="{StaticResource CardBorderBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ScreenRecordingLabelText"
                         Grid.Column="0"
                         VerticalAlignment="Top"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Text="录屏兼容" />
              <StackPanel Grid.Column="1">
                <CheckBox x:Name="AllowScreenRecordingCheckBox"
                          IsChecked="True"
                          Content="允许录屏捕获程序浮层（推荐）"
                          Click="OnCapturePreferenceChanged"
                          Style="{StaticResource GlassCheckBox}" />
                <TextBlock x:Name="ScreenRecordingDescriptionText"
                           Margin="29,6,0,0"
                           Style="{StaticResource SecondaryText}"
                           Text="教程录制会包含状态浮窗和命中红窗；不会改变鼠标拦截。" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Expander>
      </Border>

      <Border Grid.Row="6"
              Margin="0,1,0,0"
              Padding="14,11"
              Background="{StaticResource SurfaceTintBrush}"
              BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="1"
              CornerRadius="11">
        <TextBlock x:Name="ShortcutHintText"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Text="Ctrl + Shift + F11 框选区域  ·  Ctrl + Shift + F12 确认告警  ·  每次命中后请重新点击「开始监控」" />
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
